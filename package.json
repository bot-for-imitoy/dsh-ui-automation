{
  "name": "dsh-ui-automation",
  "version": "2.1.0",
  "type": "module",
  "description": "Linux-only numbered-image UI control for DSH: screenshot a display with yellow numbered badges, then click, double-click, scroll, drag and type by index; every action returns the next numbered image.",
  "license": "MIT",
  "author": "bot-for-imitoy",
  "homepage": "https://github.com/bot-for-imitoy/dsh-ui-automation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bot-for-imitoy/dsh-ui-automation.git"
  },
  "bugs": {
    "url": "https://github.com/bot-for-imitoy/dsh-ui-automation/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "ui-automation",
    "numbered-screenshot",
    "screen-numbering",
    "at-spi",
    "xdotool",
    "xtest",
    "gui-testing",
    "accessibility",
    "linux"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "scripts/numbering.py",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "VERIFY.md",
    "LICENSE",
    "screenshots",
    "test/Makefile",
    "test/integration.mjs",
    "test/reliability.mjs",
    "test/smoke.mjs",
    "test/capture-screenshots.mjs",
    "test/lib",
    "test/fixtures",
    "docs",
    "test/gtk4-probe"
  ],
  "scripts": {
    "fixtures": "make -C test fixtures",
    "test": "node test/integration.mjs",
    "test:reliability": "node test/reliability.mjs",
    "test:capture": "node test/capture-screenshots.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
